source "https://rubygems.org"

# `github-pages` pins the exact gem versions GitHub's servers use to build
# your site, so what you see locally is what goes live. GitHub builds the
# site itself — this file is only for previewing on your own machine.
gem "github-pages", group: :jekyll_plugins

# Needed on Ruby 3.0+ (these left the standard library).
gem "webrick", "~> 1.8"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
