---
# Hand-written Atom feed, replacing the one jekyll-feed generates.
# jekyll-feed has no way to exclude a post, and it skips generating its own
# feed when a file already exists at this path — so this file wins.
# The only difference from the generated one is the `unlisted` filter below.
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  {%- assign listed = site.posts | where_exp: "post", "post.unlisted != true" -%}
  {%- assign updated = listed.first.date | default: site.time -%}

  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" />
  <updated>{{ updated | date_to_xmlschema }}</updated>
  <id>{{ '/feed.xml' | absolute_url | xml_escape }}</id>
  <title type="html">{{ site.title | smartify | xml_escape }}</title>
  {%- if site.description %}
  <subtitle>{{ site.description | strip_newlines | strip | xml_escape }}</subtitle>
  {%- endif %}
  {%- if site.author.name %}
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    {%- if site.author.email and site.author.email != "" %}
    <email>{{ site.author.email | xml_escape }}</email>
    {%- endif %}
  </author>
  {%- endif %}

  {%- for post in listed %}
  <entry>
    <title type="html">{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post.id | absolute_url | xml_escape }}</id>
    <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}">{{ post.content | strip | xml_escape }}</content>
    {%- if site.author.name %}
    <author><name>{{ site.author.name | xml_escape }}</name></author>
    {%- endif %}
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}" />
    {%- endfor %}
    {%- if post.description %}
    <summary type="html">{{ post.description | strip_html | normalize_whitespace | xml_escape }}</summary>
    {%- endif %}
  </entry>
  {%- endfor %}
</feed>
